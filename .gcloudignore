#!include:.gitignore

# Jistota i kdyby se .gitignore zmenil: tajemstvi ven nikdy.
.env
.env.*
credentials.json
*.credentials.json

# Do obrazu nepatri, jen by zdrzovalo upload (.venv ma 175 MB).
.git
.git/
.venv/
.pytest_cache/
tests/
docs/
